# =========================================
# ENVIRONMENT CONFIGURATION - Dream Sport Manouba
# =========================================

# Application
NODE_ENV=development
APP_NAME="Dream Sport Manouba"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000
FRONTEND_PORT=3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dream_sport_db
DB_USER=dream_sport_user
DB_PASSWORD=dream_sport_password
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# JWT / Authentication
JWT_SECRET=your_super_secure_jwt_secret_key_min_32_chars_long
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secure_refresh_token_secret_min_32_chars_long
JWT_REFRESH_EXPIRES_IN=30d

# Session
SESSION_SECRET=your_super_secure_session_secret_key

# Admin Credentials (Seed)
ADMIN_EMAIL=admin@dreamsport.tn
ADMIN_PASSWORD=admin123456
ADMIN_NAME=Admin
ADMIN_FIRSTNAME=Dream

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880 # 5MB
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp,avif

# Cloudinary (Optional - for production image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (SMTP) - Optional
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@dreamsport.tn
SMTP_FROM_NAME="Dream Sport Manouba"

# WhatsApp
WHATSAPP_NUMBER=21600000000

# Social Media Links (Defaults)
FACEBOOK_URL=https://facebook.com
INSTAGRAM_URL=https://instagram.com
TIKTOK_URL=https://tiktok.com
YOUTUBE_URL=https://youtube.com

# Google Maps
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_LOCATION=https://maps.google.com/?q=Manouba+Tunis+Tunisie

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX=100 # Max requests per window

# Security
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
